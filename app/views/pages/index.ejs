<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classificação de Idade por Categoria</title>
    <style>
        .erro { border: 2px solid red; }
        .msg-erro { color: red; font-size: 0.9em; }
    </style>
</head>
<body>
    <%

    let erroValidacao = { "idade": "" };
    let msgErro = { "idade": "" };


    if(erros) {

        
        let listaErros = erros.errors ? erros.errors : erros;

        listaErros.forEach(function(erro) {
            if (erro.path == "idade") {
                erroValidacao.idade = "erro";
                msgErro.idade = erro.msg;
            }
        });
    }
    %>

    <h2>Classificar Categoria de Idade</h2>

    <form action="/classificar" method="post">
        <label for="idade">Digite sua idade:</label> <br>
        
        <input type="text" name="idade" id="idade" 
               value="<%= valores.idade %>" 
               class="<%= erroValidacao.idade %>"> 
        
        <span class="msg-erro"><%= msgErro.idade %></span> <br><br>

        <button type="submit">Classificar</button>
    </form>

    <hr>

    <% if(retorno) { %>
        <h2>Categoria: <%= retorno.categoria %></h2>
    <% } else { %>
        <h2>Aguardando classificação...</h2>
    <% } %>

</body>
</html>